# 应用端口（映射到宿主机）
PORT=3000

# 基础镜像。国内网络无法访问 Docker Hub 时使用下方镜像源（默认已配置）
# 官方源（需能访问 auth.docker.io）:
# NODE_IMAGE=node:20-alpine
NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine

# npm 安装依赖时的 registry（可选）
NPM_REGISTRY=https://registry.npmmirror.com
USE_CN_MIRROR=1

# AI 助手（OpenAI 兼容协议，默认本机 Ollama）
# 容器访问宿主机 Ollama 时使用 host.docker.internal
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2
# 云厂商 API Key（Ollama 可留空）
AI_API_KEY=
